# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne jamais committer le fichier .env (voir .gitignore).

# PostgreSQL
DATABASE_URL=postgresql://o2passions_user:change-me@localhost:5432/o2passions

# JWT
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_HOURS=24

# Stripe (laisser vide en dev pour activer le mode simulé de payment_service.py)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Front-end (pour CORS)
FRONTEND_ORIGIN=http://localhost:5500

FLASK_ENV=development
